# ============================================
# Mira - Environment Variables
# ============================================

# Application
APP_NAME=Mira
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please-use-a-long-random-string

# ============================================
# Database — Docker local (padrão)
# ============================================
DATABASE_URL=postgresql+asyncpg://beacon:beacon_secret@127.0.0.1:5433/beacon
DATABASE_URL_SYNC=postgresql://beacon:beacon_secret@127.0.0.1:5433/beacon

# Alternativa Supabase: use a URL do Transaction Pooler e troque o prefixo
# para postgresql+asyncpg:// em DATABASE_URL.
# Storage persistente dos modelos base e por tenant. Em produção, aponte para um volume persistente.
MODEL_STORAGE_DIR=data/model_artifacts

# Redis (broker da fila assíncrona de retenção)
REDIS_URL=redis://localhost:6379/0
RETENTION_QUEUE_NAME=beacon:retention:jobs
RETENTION_JOB_TTL_SECONDS=86400
RETENTION_MAX_ATTEMPTS=3
RETENTION_RETRY_BACKOFF_SECONDS=5
RETENTION_DEAD_LETTER_QUEUE_NAME=beacon:retention:dead-letter

# Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Security / LGPD
DATA_RETENTION_DAYS=365
ANONYMIZE_ON_EXPORT=true

# Composio — integração externa (desativada por padrão; chave somente no secret manager)
COMPOSIO_ENABLED=false
COMPOSIO_API_KEY=
# Segredo estável e dedicado; não reutilizar SECRET_KEY (pode sofrer rotação).
COMPOSIO_IDENTITY_SECRET=
COMPOSIO_CALLBACK_URL=
# Allowlist vazia por padrão; não liberar o catálogo inteiro automaticamente.
COMPOSIO_ALLOWED_TOOLKITS=

# MIRA Educação nativa + Portal do Aluno
# DESABILITADOS até homologação da migration 056, testes RLS e convites seguros.
# A API FastAPI + PostgreSQL substitui a necessidade de hospedar o Frappe.
NATIVE_ACADEMIC_ENABLED=false
STUDENT_PORTAL_ENABLED=false
NATIVE_ACADEMIC_CATALOG_ENABLED=false
NATIVE_ACADEMIC_SERVICES_ENABLED=false

# Mira — autenticação (configure no ambiente do backend; nunca versione valores reais)
MIRA_PUBLIC_URL=http://localhost:3000
MIRA_ADMIN_SECRET=

# Firecrawl — enriquecimento opcional do site no onboarding (segredo somente no backend)
FIRECRAWL_API_KEY=

# ============================================
# Agentes de Retencao (Orquestrador + WhatsApp/E-mail/SMS)
# Ver docs/AGENTES.md — tudo opcional, default e modo dry-run (nao envia nada de verdade)
# ============================================
AGENTS_DRY_RUN_DEFAULT=true
AGENTS_MIN_HOURS_BETWEEN_CONTACT=48
AGENTS_MAX_CONTACTS_PER_WEEK=3
INTERVENTION_LOG_RETENTION_DAYS=180
AGENTS_PROVIDER_TIMEOUT_SECONDS=15
AGENTS_RATE_LIMIT_ENABLED=true
AGENTS_RATE_LIMIT_PER_TENANT_PER_MINUTE=60
AGENTS_RATE_LIMIT_PER_CHANNEL_PER_MINUTE=60
AGENTS_RATE_LIMIT_PER_PROVIDER_PER_MINUTE=120
AGENTS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AGENTS_CIRCUIT_BREAKER_OPEN_SECONDS=60
# Backpressure: reduz o limite do provider por um período quando a latência supera o limite
AGENTS_PROVIDER_LATENCY_THRESHOLD_MS=2500
AGENTS_PROVIDER_BACKPRESSURE_FACTOR=0.5
# Reserva distribuída por mensagem (SET NX + TTL)
AGENTS_IDEMPOTENCY_TTL_SECONDS=86400
# Providers primário -> secundário (só considera os que estiverem configurados)
WHATSAPP_PROVIDER_ORDER=waha,evolution

# WhatsApp real (Evolution API) — opcional
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# E-mail real (Resend) — opcional
RESEND_API_KEY=
EMAIL_FROM=

# SMS real (Twilio) — opcional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ENGAGEMENT_TIMEZONE=America/Sao_Paulo
ENGAGEMENT_RESPONSE_WINDOW_HOURS=72
ENGAGEMENT_HISTORY_DAYS=90
ENGAGEMENT_SWEEP_INTERVAL_SECONDS=3600
# Pause redundant SMS after a recent click/reply
ENGAGEMENT_CHANNEL_SUPPRESSION_HOURS=72
# Estimated BRL unit cost per send; 0.0 means not configured
AGENTS_COST_PER_WHATSAPP_MESSAGE_BRL=0.0
AGENTS_COST_PER_EMAIL_MESSAGE_BRL=0.0
AGENTS_COST_PER_SMS_MESSAGE_BRL=0.0
