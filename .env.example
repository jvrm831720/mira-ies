# ============================================
# Project Beacon - Environment Variables
# ============================================

# Application
APP_NAME=Project Beacon
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-please-use-a-long-random-string

# ============================================
# Database — SUPABASE CLOUD (recomendado)
# ============================================
# 1. Acesse o painel do Supabase → Project Settings → Database
# 2. Copie a "Connection string" no modo URI
# 3. Escolha "Transaction" pooler (porta 6543) — melhor para async
# 4. Substitua [YOUR-PASSWORD] pela senha do banco
# 5. Troque o prefixo de postgresql:// para postgresql+asyncpg://
#
# Exemplo real:
# DATABASE_URL=postgresql+asyncpg://postgres.abcdefghijk:sua-senha-aqui@aws-0-us-east-1.pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# (Opcional) versão síncrona se precisar de Alembic depois
DATABASE_URL_SYNC=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis (ainda local / opcional nesta fase)
REDIS_URL=redis://localhost:6379/0

# Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=csv,xlsx,xls

# Security / LGPD
DATA_RETENTION_DAYS=365
ANONYMIZE_ON_EXPORT=true

# Communication (configurar nas próximas fases)
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
